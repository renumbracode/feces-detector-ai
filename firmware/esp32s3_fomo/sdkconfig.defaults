# Target: ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# Enable PSRAM (needed for camera framebuffers + ML tensor arena)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Keep the HTTP server simple
CONFIG_ESP_HTTP_SERVER_ENABLE_MDNS=n

# app_main runs the whole boot path (config load, Wi-Fi init) on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Optimize for size/speed of inference
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_OPTIMIZATION_ASSERTIONS_DISABLED=y

# CPU clock. This was 160 MHz, which is not the S3's maximum. The tensor arena
# is 479,948 bytes and is heap-allocated (EI_CLASSIFIER_ALLOCATION_STATIC is
# off), so with SPIRAM_USE_MALLOC + ALWAYSINTERNAL=4096 it lands in PSRAM
# alongside every camera framebuffer -- a 469 KB arena touched at every
# convolution. Measured on-device via the SDK's own timing split
# ("classify: dsp=13ms infer=1042ms post=0ms"): the network is the entire
# cost, the decode is negligible. 160 MHz bought nothing but 1/3 more clock
# time than the part can give.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Console over the single native OTG cable (flash + ESP_LOG + monitor
# all on one USB-C). Serial console goes to UART0 by default; we switch
# it to the native USB-Serial/JTAG so the TTL port isn't needed at all.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table -- the repo's partitions.csv IS the layout on the board
#
# CONFIG_PARTITION_TABLE_CUSTOM=y makes the build use partitions.csv instead of
# ESP-IDF's built-in single-app table. This was flipped ON on 2026-10-27: the
# single-app table leaves only a 1 MB app partition, which was 99.3% full and
# could not fit the actuator-board publisher. partitions.csv gives the app
# 0x1E0000 (1.875 MB) and adds a fat `storage` partition.
#
# The layout (verified by the boot log's own partition dump and by reading
# 0x8000 off the board):
#
#   nvs       0x9000   0x6000 (24K)
#   phy_init  0xf000   0x1000 (4K)
#   factory   0x10000  0x1E0000 (1.875M)   <- the app partition
#   storage   0x1F0000 0x210000 (2.06M)    <- fat, unused by the firmware
#
# NVS is at 0x9000/0x6000 in BOTH the old and the new layout, so switching
# layouts does not touch the stored Wi-Fi credentials, the static address or
# the URLs. Only the partition table at 0x8000 and the app at 0x10000 need
# reflashing.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
