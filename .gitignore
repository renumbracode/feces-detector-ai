# Dataset media (keep the .gitkeep placeholders)
dataset/images/train/*
dataset/images/val/*
dataset/labels/train/*
dataset/labels/val/*
!dataset/images/train/.gitkeep
!dataset/images/val/.gitkeep
!dataset/labels/train/.gitkeep
!dataset/labels/val/.gitkeep

# Training artifacts
training/runs/*
!training/runs/.gitkeep
training/*.zip
dataset/*.zip
training/*.json
training/fomo/out_fomo/*
!training/fomo/out_fomo/.gitkeep
training/fomo/out_ei/*
!training/fomo/out_ei/.gitkeep
*.pt

# ESP32-S3 firmware build artifacts
firmware/esp32s3_fomo/build/
firmware/esp32s3_fomo/sdkconfig*
# ...but sdkconfig.defaults is the project's PER-CHECKED-IN defaults and must
# be tracked: ESP-IDF's own default for the S3 is 160 MHz (see
# esp32s3/Kconfig.cpu), so without this file a fresh clone silently builds the
# slow-clock firmware and loses ~1/3 of inference throughput with nothing in the
# diff to explain it. The generated sdkconfig stays ignored.
!firmware/esp32s3_fomo/sdkconfig.defaults
firmware/esp32s3_fomo/managed_components/
firmware/esp32s3_fomo/dependencies.lock
firmware/esp32s3_fomo/components/inference/edge_impulse/*
!firmware/esp32s3_fomo/components/inference/edge_impulse/.gitkeep
!firmware/esp32s3_fomo/components/inference/edge_impulse/README.md

# Main ESP32 (the actuator board) build artifacts -- same rules as the camera
# board's project above. Without these the build tree (126 MB, 1305 files) and
# the generated sdkconfig would be committed.
firmware/esp32_main/build/
firmware/esp32_main/sdkconfig*
!firmware/esp32_main/sdkconfig.defaults
firmware/esp32_main/managed_components/
firmware/esp32_main/dependencies.lock

# Edge Impulse export archives (unpacked into the gitignored SDK folder)
*impulse-#1.zip

# Ultralytics label caches (regenerated on every val run)
*.cache

# Ultralytics val output written to CWD by validate.py
/runs/

# Python
__pycache__/
*.pyc
.venv/

# Runtime logs (verifier stdout/stderr, start_verifier.sh writes here).
# These are runtime state, not source: the verifier's log grows without bound
# and must never be committed.
logs/

# Local agent workspace / session plans
.opencode/

# Editors / tooling
.vscode/
.idea/
